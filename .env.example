# Where the gateway answers.
#   local development : http://localhost:5007
#   deployed          : https://api.gaadipe.in
# Empty in development: calls go through the Vite proxy (vite.config.js).
# Set it for a production build, e.g. https://api.gaadipe.in
VITE_API_BASE=

# The WhatsApp number people are sent to, with the country code.
VITE_WHATSAPP=916363271302

# Offer WhatsApp as a way in? Off while the browser journey is measured on its
# own; set to 1 to put the links back.
VITE_WHATSAPP_ENABLED=0

# QuizPe cross-sell: off since 2026-09-23 (see lib/api.js).
VITE_QUIZPE_ENABLED=0
